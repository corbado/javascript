# Non-secret config for Connect tests in CI.
# Loaded by playwright.config.connect.ts via dotenv.
# Most Connect config (NEXT_PUBLIC_*, AWS_*, CORBADO_*) comes from GitHub Actions env
# because the Next.js playground needs them in process.env at build time.


DEVELOPERPANEL_API_URL=https://console.cloud.corbado-staging.io

NEXT_PUBLIC_CORBADO_PROJECT_ID=pro-4641896612641727554
NEXT_PUBLIC_CORBADO_FRONTEND_API_URL_SUFFIX=frontendapi.cloud.corbado-staging.io
CORBADO_BACKEND_API_URL=https://backendapi.cloud.corbado-staging.io

DEFAULT_CORBADO_BACKEND_API_BASIC_AUTH=
NEXT_PUBLIC_AWS_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_AWS_COGNITO_CLIENT_ID=
AWS_REGION=
AWS_COGNITO_USER_POOL_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_COGNITO_CLIENT_ID=
AWS_COGNITO_CLIENT_SECRET=
