# Non-secret config for Complete tests in CI.
# Loaded by playwright.config.complete.ts via dotenv (override: true).
# Secrets (PLAYWRIGHT_JWT_TOKEN, PLAYWRIGHT_GOOGLE_*, DEFAULT_CORBADO_BACKEND_API_BASIC_AUTH)
# come from GitHub Actions env — do NOT add them here (dotenv override would blank them).

PLAYWRIGHT_TEST_URL=http://localhost
DEVELOPERPANEL_API_URL=https://console.cloud.corbado-staging.io
CORBADO_BACKEND_API_URL=https://backendapi.cloud.corbado-staging.io
FRONTEND_API_URL_SUFFIX=frontendapi.cloud.corbado-staging.io
DEFAULT_CORBADO_PROJECT_ID=pro-4505536417832482032
