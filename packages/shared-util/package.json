{
  "name": "@corbado/shared-util",
  "version": "1.0.7",
  "description": "Shared utilities for Corbado packages",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./bundle": "./dist/bundle/index.js"
  },
  "scripts": {
    "build": "npm run clean && tsc -b && npm run build:bundles",
    "build:dev": "npm run build",
    "build:types": "tsc",
    "build:bundles": "node esbuild.config.js",
    "clean": "rimraf dist",
    "prebuild": "npm run clean"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "corbado",
    "utilities"
  ],
  "author": "Corbado",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.20.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "gitHead": "c4c3ea12679f60f395ce56f05f2c028ca36fb4ee"
}
